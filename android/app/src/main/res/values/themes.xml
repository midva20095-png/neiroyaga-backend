<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NeyroYaga" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.NeyroYaga.Main</item>
    </style>

    <style name="Theme.NeyroYaga.Main" parent="Theme.AppCompat.NoActionBar">
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorAccent">@color/pink</item>
        <item name="colorPrimary">@color/purple</item>
    </style>
</resources>
